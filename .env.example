# Copy to .env and edit. See server/README.md.

# MongoDB connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/perfusense"
# Port of the API server (the Vite dev server proxies /api to it).
PORT=4000
# Browser origins allowed to call the API directly (comma separated).
CORS_ORIGIN="http://localhost:3000"
# Shared secret sent by the mat (ESP32) in the x-device-key header. Change it.
DEVICE_KEY="change-me-device-key"
# Time zone used for clock times in API responses.
WARD_TZ="Africa/Cairo"
# true = feed fake telemetry for every bed so the UI is alive without hardware.
SIMULATE=false
